<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- No package= attribute: $(ApplicationId) from Horus.csproj is the single source of
	     truth. It must stay com.horus.vpn — libhev_socks.so resolves its JNI entry points
	     against the class com/horus/vpn/VPNService. -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:supportsRtl="true" android:label="Horus" android:extractNativeLibs="true"
		android:largeHeap="true"
		android:memtagMode="off"
		android:gwpAsanMode="never"
		android:allowNativeHeapPointerTagging="false"
		android:pageSizeCompat="enabled">
		<!--
		  The four attributes above are not cosmetic.

		  memtagMode / gwpAsanMode / allowNativeHeapPointerTagging: libxray.so is xray-core,
		  which is Go, linked into this process. ARM MTE, pointer tagging and GWP-ASan all
		  hand the Go allocator pointers it does not expect, and on ARMv8.5+ hardware
		  (Pixel 8 and newer) that surfaces as rare, unreproducible SIGSEGVs inside the core
		  — a native crash no managed handler ever sees. RethinkDNS hit exactly this and
		  documents it as celzero/rethink-app#786.

		  largeHeap: the MAUI runtime, the Go heap and a ~55 MB native library share one
		  address space. The default heap limit is not generous enough for that.

		  pageSizeCompat: Android 15+ devices may use 16 KB pages. hev is already built with
		  16 KB-aligned segments (see Platforms/Android/lib/README.md); this covers the rest.
		-->

		<!-- Must match [Service(Name = …)] on HorusVpnTunnelService character for character,
		     or the manifest merger emits two <service> elements and fails. ${applicationId}
		     is not substituted before that validation runs, so the name is spelled out. -->
		<service
			android:name="com.horus.vpn.HorusVpnTunnelService"
			android:permission="android.permission.BIND_VPN_SERVICE"
			android:exported="false"
			android:foregroundServiceType="systemExempted|specialUse"
			android:stopWithTask="false">
			<intent-filter>
				<action android:name="android.net.VpnService" />
			</intent-filter>
			<!--
			  systemExempted first, specialUse as the fallback.

			  A VpnService is one of the categories Android documents as exempt from
			  background restrictions, and systemExempted is the type that says so. Both
			  reference clients use it — RethinkDNS as systemExempted|connectedDevice,
			  NekoBox as systemExempted — and neither shows the "tunnel dies a while after
			  the screen goes off" behaviour this app had.

			  specialUse is the generic escape hatch and carries none of that meaning; a
			  service declared with it is subject to the ordinary background rules. It stays
			  declared so a device that refuses systemExempted still has a type to fall back
			  to at runtime (see TryStartForeground), which is the only reason the property
			  below is still here.
			-->
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="vpn" />

			<!-- Declaring these is what un-greys "Always-on VPN" and "Block connections
			     without VPN" in Settings → Network → VPN → Horus. Always-on is the single
			     most reliable survival mechanism on Android, because the system itself
			     becomes responsible for starting the service — it outlives OEM task
			     killers, low-memory kills and reboots without any code of ours running.
			     BootReceiver deliberately stands down when it is enabled. -->
			<meta-data
				android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
				android:value="true" />
			<meta-data
				android:name="android.net.VpnService.SUPPORTS_LOCKDOWN"
				android:value="true" />
		</service>
	</application>
	<!-- Required to enumerate launchable apps for the split-tunnelling picker. Without it
	     PackageManager.QueryIntentActivities returns nothing on Android 11+. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent>
	</queries>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Normal permission, no prompt. Needed for ConnectivityManager.requestNetwork and
	     registerBestMatchingNetworkCallback, which report THE default physical network
	     rather than every network matching the request. registerDefaultNetworkCallback is
	     not an option: since Android P it returns our own VPN interface, so it goes quiet
	     exactly when the link underneath changes. -->
	<uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

	<!-- Bringing the tunnel back after a reboot. See BootReceiver for the checks that
	     stop it from fighting Always-on VPN or a user who turned the VPN off. -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<!-- Self-update. REQUEST_INSTALL_PACKAGES is an app-op the user grants per app under
	     "Install unknown apps"; sideloading the first APK grants it to the browser, not to
	     us, so the updater asks for it once. UPDATE_PACKAGES_WITHOUT_USER_ACTION is a
	     normal permission and is what lets setRequireUserAction(USER_ACTION_NOT_REQUIRED)
	     be honoured — for a self-update that is enough, with no installer-of-record
	     requirement, so updates apply with no prompt at all. -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

	<!-- Doze is what kills a long-lived tunnel: it cuts the app's network in the idle
	     windows, and the connection dies with no event to notice it by. The exemption is
	     also what allows the foreground service to be started from the background, which is
	     how the Quick Settings tile and the reconnect-after-update path work at all. -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
