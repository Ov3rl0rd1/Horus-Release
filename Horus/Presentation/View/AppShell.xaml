<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Horus.Presentation.View.AppShell"
    Shell.FlyoutBehavior="Disabled"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Horus.Presentation.View"
    Title="Horus">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:AuthPage}"
        Route="AuthPage" />
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />
    <ShellContent
        Title="Admin"
        ContentTemplate="{DataTemplate views:AdminPage}"
        Route="Admin" />
    
    <TabBar
        Shell.BackgroundColor="{StaticResource NightPurple}"
        Shell.TabBarTitleColor="{StaticResource TextAccent}"
        Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

        <Tab Title="HOME">
            <Tab.Icon>
                <FontImageSource Glyph="⊙" FontFamily="OpenSansRegular" Size="22" />
            </Tab.Icon>
            <ShellContent
                Title="Main"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="ADMIN">
            <Tab.Icon>
                <FontImageSource Glyph="⚙" FontFamily="OpenSansRegular" Size="22" />
            </Tab.Icon>
            <ShellContent
        Title="Admin"
        ContentTemplate="{DataTemplate views:AdminPage}"
        Route="AdminPage" />
        </Tab>
        
        <Tab Title="SETTINGS">
            <Tab.Icon>
                <FontImageSource Glyph="⚙" FontFamily="OpenSansRegular" Size="22" />
            </Tab.Icon>
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="SettingsPage" />
        </Tab>

    </TabBar>
</Shell>
