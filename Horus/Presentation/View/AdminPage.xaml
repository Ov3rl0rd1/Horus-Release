<?xml version="1.0" encoding="utf-8" ?>
<!-- Compiled only when ADMIN_MODE is defined in Horus.csproj -->
<ContentPage
    x:Class="Horus.Presentation.View.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
    xmlns:models="clr-namespace:Horus.Domain.Models"
    x:DataType="vm:AdminViewModel"
    Title="Admin Panel"
    BackgroundColor="{StaticResource DeepVoid}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label Text="⚙" FontSize="18" TextColor="{StaticResource NeonViolet}" VerticalOptions="Center" />
                <Label
                    Text="ADMIN MODE"
                    Style="{StaticResource LabelAccent}"
                    TextColor="{StaticResource NeonViolet}"
                    FontSize="{StaticResource FontSizeMD}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- ── Local mode banner ──────────────────────────────────────── -->
            <Frame
                BackgroundColor="{Binding IsLocalMode, Converter={StaticResource LocalModeBannerBg}}"
                BorderColor="{StaticResource OverlayBorder}"
                CornerRadius="16"
                Padding="16,12"
                HasShadow="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding LocalModeLabel}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{Binding IsLocalMode, Converter={StaticResource LocalModeLabelColor}}" />
                        <Label
                            Text="{Binding ApiStatusLabel}"
                            Style="{StaticResource LabelSecondary}"
                            IsVisible="{Binding ApiStatusLabel, Converter={StaticResource StringToBoolConverter}}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button
                            Text="Probe"
                            Style="{StaticResource ButtonGhost}"
                            FontSize="11"
                            Padding="12,6"
                            Command="{Binding ProbeApiCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                        <!--
                            Mode=OneWay: ViewModel → Switch only (prevents binding-driven Toggled events).
                            Toggled handler in code-behind uses a guard flag for user-initiated changes.
                        -->
                        <Switch
                            x:Name="LocalModeSwitch"
                            IsToggled="{Binding IsLocalMode, Mode=OneWay}"
                            ThumbColor="{StaticResource NeonViolet}"
                            VerticalOptions="Center"
                            Toggled="OnLocalModeToggled" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- ── Local server list ───────────────────────────────────────── -->
            <Label Text="Local Servers" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <Button
                        Text="+ Add Server"
                        Style="{StaticResource ButtonGhost}"
                        HorizontalOptions="Fill"
                        Command="{Binding AddServerCommand}" />

                    <!-- Server list -->
                    <CollectionView ItemsSource="{Binding LocalServers}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LocalServerEntry">
                                <Frame
                                    BackgroundColor="{StaticResource NightPurple}"
                                    BorderColor="Transparent"
                                    CornerRadius="12"
                                    Margin="0,4"
                                    Padding="14,12"
                                    HasShadow="False">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <VerticalStackLayout Grid.Row="0" Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource LabelPrimary}" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayText}" Style="{StaticResource LabelSecondary}" />
                                            <Label Text="{Binding Protocol}" Style="{StaticResource LabelCaption}" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End">
                                            <Button
                                                Text="★ Default"
                                                Style="{StaticResource ButtonGhost}"
                                                FontSize="11"
                                                Padding="12,6"
                                                TextColor="{StaticResource NeonCyan}"
                                                BorderColor="{StaticResource NeonCyan}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SetDefaultServerCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Text="✎ Edit"
                                                Style="{StaticResource ButtonGhost}"
                                                FontSize="11"
                                                Padding="12,6"
                                                TextColor="{StaticResource NeonViolet}"
                                                BorderColor="{StaticResource NeonViolet}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=EditServerCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Text="⏎ Connect"
                                                Style="{StaticResource ButtonGhost}"
                                                FontSize="11"
                                                Padding="12,6"
                                                TextColor="{StaticResource NeonGreen}"
                                                BorderColor="{StaticResource NeonGreen}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ConnectLocalServerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Edit form (shown when IsEditing = true) -->
                    <Frame
                        IsVisible="{Binding IsEditing}"
                        BackgroundColor="{StaticResource NightPurple}"
                        BorderColor="{StaticResource OverlayBorder}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="{Binding IsNewEntry, Converter={StaticResource BoolToStringConverter}}"
                                Style="{StaticResource LabelCaption}"
                                TextColor="{StaticResource NeonViolet}" />

                            <Entry Placeholder="Name (optional)" Text="{Binding EditName}" Style="{StaticResource EntryField}" />
                            <Entry Placeholder="Host *" Text="{Binding EditHost}" Style="{StaticResource EntryField}" Keyboard="Url" />
                            <Entry Placeholder="Port" Text="{Binding EditPort}" Style="{StaticResource EntryField}" Keyboard="Numeric" />
                            <Entry Placeholder="Auth token / password *" Text="{Binding EditAuth}" Style="{StaticResource EntryField}" IsPassword="True" />
                            <Entry Placeholder="Obfuscation type (salamander / empty)" Text="{Binding EditObfsType}" Style="{StaticResource EntryField}" />
                            <Entry Placeholder="Obfs password" Text="{Binding EditObfsPassword}" Style="{StaticResource EntryField}" IsPassword="True" />
                            <Entry Placeholder="Ports range (e.g. 443:8000)" Text="{Binding EditPortsRange}" Style="{StaticResource EntryField}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Lazy TLS / insecure" Style="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EditLazyTls}" ThumbColor="{StaticResource NeonViolet}" />
                            </Grid>

                            <Label Text="Raw Config (overrides all fields)" Style="{StaticResource LabelCaption}" />
                            <Button
                                Text="Generate from Fields"
                                Style="{StaticResource ButtonGhost}"
                                Command="{Binding GenerateConfigPreviewCommand}"
                                HorizontalOptions="Fill" />
                            <Editor
                                Text="{Binding EditRawConfig}"
                                BackgroundColor="{StaticResource DeepVoid}"
                                TextColor="{StaticResource TextPrimary}"
                                FontFamily="Courier"
                                FontSize="11"
                                HeightRequest="150"
                                AutoSize="Disabled" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button
                                    Grid.Column="0"
                                    Text="Save"
                                    Style="{StaticResource ButtonPrimary}"
                                    BackgroundColor="{StaticResource NeonViolet}"
                                    Command="{Binding SaveServerCommand}" />
                                <Button
                                    Grid.Column="1"
                                    Text="Cancel"
                                    Style="{StaticResource ButtonGhost}"
                                    Command="{Binding CancelEditCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- ── Direct override connect ─────────────────────────────────── -->
            <Label Text="Direct Override Connect" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <Picker
                        Title="Protocol"
                        ItemsSource="{Binding AvailableProtocols}"
                        SelectedItem="{Binding SelectedProtocol}"
                        TextColor="{StaticResource TextPrimary}"
                        BackgroundColor="{StaticResource NightPurple}" />

                    <Entry Placeholder="Host" Text="{Binding ServerHost}" Style="{StaticResource EntryField}" Keyboard="Url" />
                    <Entry Placeholder="Port" Text="{Binding ServerPort}" Style="{StaticResource EntryField}" Keyboard="Numeric" />
                    <Entry Placeholder="Auth token" Text="{Binding AuthToken}" Style="{StaticResource EntryField}" IsPassword="True" />
                    <Entry Placeholder="Obfs type (salamander)" Text="{Binding ObfsType}" Style="{StaticResource EntryField}" />
                    <Entry Placeholder="Obfs password" Text="{Binding ObfsPassword}" Style="{StaticResource EntryField}" IsPassword="True" />
                    <Entry Placeholder="Ports range" Text="{Binding PortsRange}" Style="{StaticResource EntryField}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Lazy TLS / insecure" Style="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding LazyTls}" ThumbColor="{StaticResource NeonViolet}" />
                    </Grid>

                    <Button
                        Text="Generate YAML Preview"
                        Style="{StaticResource ButtonGhost}"
                        Command="{Binding LoadRawConfigFromPresetCommand}"
                        HorizontalOptions="Fill" />

                    <Editor
                        Text="{Binding RawConfig}"
                        BackgroundColor="{StaticResource NightPurple}"
                        TextColor="{StaticResource TextPrimary}"
                        FontFamily="Courier"
                        FontSize="11"
                        HeightRequest="160"
                        AutoSize="Disabled"
                        Placeholder="Raw config (overrides fields above)" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Text="CONNECT"
                            Style="{StaticResource ButtonPrimary}"
                            BackgroundColor="{StaticResource NeonViolet}"
                            Command="{Binding ConnectWithOverrideCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                        <Button
                            Grid.Column="1"
                            Text="DISCONNECT"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- ── Status / busy ────────────────────────────────────────────── -->
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource NeonViolet}"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource LabelAccent}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                HorizontalOptions="Center" />

            <!-- ── Log viewer ────────────────────────────────────────────────── -->
            <Label Text="Protocol Log" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Live output" Style="{StaticResource LabelSecondary}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Clear" Style="{StaticResource ButtonGhost}" FontSize="11" Padding="12,6" Command="{Binding ClearLogsCommand}" />
                        <Button Grid.Column="2" Text="Export" Style="{StaticResource ButtonGhost}" FontSize="11" Padding="12,6" Command="{Binding ExportLogsCommand}" />
                    </Grid>
                    <Editor
                        Text="{Binding LogText}"
                        BackgroundColor="{StaticResource DeepVoid}"
                        TextColor="{StaticResource NeonGreen}"
                        FontFamily="Courier"
                        FontSize="11"
                        HeightRequest="280"
                        IsReadOnly="True"
                        AutoSize="Disabled" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="24" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
