<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
             x:DataType="vm:AuthFlowViewModel"
             x:Class="Horus.Presentation.View.Screens.OnboardingView">

    <Grid Padding="26,28" RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
            <Image Source="logo_gold.png" HeightRequest="104" HorizontalOptions="Center" />

            <Label Style="{StaticResource HzDisplay}" FontSize="26" HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" Text="Весь интернет." />
            <Label x:Name="HeroGradient" Style="{StaticResource HzDisplay}" FontSize="26"
                   HorizontalTextAlignment="Center" Margin="0,2,0,0" Text="Без блокировок." />

            <Label Style="{StaticResource HzDim}" FontSize="14" HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" Text="Одна кнопка — и через 10 секунд всё снова работает." />

            <VerticalStackLayout Spacing="10" Margin="0,24,0,0" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="9">
                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource HzGold}" VerticalOptions="Center" />
                    <Label Style="{StaticResource HzSemiBold}" FontSize="13" TextColor="{StaticResource HzTextDim}"
                           Text="Обход блокировок и «белых списков»" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="9">
                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource HzGold}" VerticalOptions="Center" />
                    <Label Style="{StaticResource HzSemiBold}" FontSize="13" TextColor="{StaticResource HzTextDim}"
                           Text="Kill Switch и режим без логов" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="9">
                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource HzGold}" VerticalOptions="Center" />
                    <Label Style="{StaticResource HzSemiBold}" FontSize="13" TextColor="{StaticResource HzTextDim}"
                           Text="До 5 устройств на одной подписке" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Button Text="Создать аккаунт" Style="{StaticResource HzPrimaryButton}"
                    Command="{Binding GoRegisterCommand}" />
            <Button Text="У меня уже есть аккаунт" Style="{StaticResource HzSecondaryButton}"
                    Command="{Binding GoLoginCommand}" />
            <Label Style="{StaticResource HzBodyLabel}" FontSize="11" TextColor="{StaticResource HzTextFaint}"
                   HorizontalTextAlignment="Center" Margin="0,4,0,0"
                   Text="Продолжая, вы принимаете условия сервиса" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
