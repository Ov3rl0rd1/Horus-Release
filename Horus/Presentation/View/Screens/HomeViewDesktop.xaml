<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Horus.Presentation.View.Controls"
             x:DataType="vm:MainViewModel"
             x:Name="DesktopRoot"
             x:Class="Horus.Presentation.View.Screens.HomeViewDesktop">

    <!--
        The content is bound to the viewport height rather than left to size itself. Without
        it the cards measure to their content, sit at the top, and leave the lower half of a
        1600x1000 window as bare background — the layout read as a phone screen stretched
        across a monitor. The ScrollView stays so a short window still scrolls instead of
        clipping.
    -->
    <ScrollView x:Name="DesktopScroll">
        <Grid ColumnDefinitions="*,336" ColumnSpacing="26" Padding="34,30,38,32" RowDefinitions="Auto,*" RowSpacing="20"
              MinimumHeightRequest="{Binding Source={x:Reference DesktopScroll}, Path=Height}">

            <!-- ═══ Publisher trust ═══
                 Only ever visible on a signed build whose certificate this machine does not
                 trust yet. Collapses entirely otherwise, so an unsigned dev build and an
                 already-trusted install both show nothing. -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource HzCard}"
                    Padding="18,14" IsVisible="{Binding ShowPublisherWarning}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <Ellipse Grid.Column="0" WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource HzGold}" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Издатель не подтверждён" Style="{StaticResource HzSemiBold}" />
                        <Label Text="Horus подписан собственным сертификатом. Установите его, чтобы Windows перестала считать издателя неизвестным."
                               Style="{StaticResource HzDim}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" Text="Установить" Style="{StaticResource HzSecondaryButton}"
                            Command="{Binding InstallCertificateCommand}"
                            IsEnabled="{Binding IsInstallingCertificate, Converter={StaticResource InvertBoolConverter}}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ═══ LEFT: connect card ═══ -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HzCard}" Padding="34,32,34,30" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">

                    <Border BackgroundColor="{Binding PillBg}" Stroke="{Binding PillBorder}" Padding="17,9" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="99" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="9">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{Binding StatusColor}" VerticalOptions="Center" />
                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13.5"
                                   FontAttributes="Bold" CharacterSpacing="0.5" FontFamily="{StaticResource FontBold}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Grid WidthRequest="288" HeightRequest="288" Margin="0,22,0,8" HorizontalOptions="Center">
                        <Ellipse x:Name="GlowHalo" WidthRequest="288" HeightRequest="288" Opacity="0" InputTransparent="True">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                    <GradientStop Color="#66F0C46A" Offset="0.35" />
                                    <GradientStop Color="#00F0C46A" Offset="1.0" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="GlowRing" WidthRequest="288" HeightRequest="288" StrokeThickness="1"
                                 Stroke="{StaticResource HzGoldBorder}" StrokeDashArray="2,4" />
                        <Ellipse x:Name="SpinRing" WidthRequest="270" HeightRequest="270" StrokeThickness="2.5"
                                 Stroke="{StaticResource HzGold}" StrokeDashArray="18,60" Opacity="{Binding SpinOpacity}" />
                        <Border WidthRequest="234" HeightRequest="234" Stroke="{Binding RingBorder}" StrokeThickness="1"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="117" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource HzRingTop}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource HzRingBottom}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleConnectCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                <Image Source="logo_gold.png" WidthRequest="96" Opacity="{Binding LogoOpacity}" HorizontalOptions="Center" />
                                <Label Text="{Binding BtnLabel}" TextColor="{Binding BtnWordColor}" FontSize="13.5"
                                       FontAttributes="Bold" CharacterSpacing="2.5" FontFamily="{StaticResource FontBold}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding StatusSub}" Style="{StaticResource HzDim}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding SessionDuration}" IsVisible="{Binding ShowTimer}" FontSize="34"
                           TextColor="{StaticResource HzGoldLight}" CharacterSpacing="1" HorizontalOptions="Center"
                           FontFamily="{StaticResource FontBody}" Margin="0,4,0,0" />

                    <!-- Server selector -->
                    <Border Style="{StaticResource HzCard}" Padding="18,15" Margin="0,22,0,0"
                            MaximumWidthRequest="470" HorizontalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoServersCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{StaticResource HzGoldSoft}" Stroke="{StaticResource HzGoldBorder}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                <Label Text="{Binding CurCode}" TextColor="{StaticResource HzGoldLight}" FontSize="11.5"
                                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                       FontFamily="{StaticResource FontBold}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding CurName}" Style="{StaticResource HzBodyLabel}" FontAttributes="Bold" />
                                <Label Text="{Binding CurSub}" Style="{StaticResource HzDim}" FontSize="13.5" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding CurPing}" IsVisible="{Binding ShowCurPing}"
                                   TextColor="{Binding CurPingColor}" FontSize="12.5" FontAttributes="Bold"
                                   FontFamily="{StaticResource FontBold}" VerticalOptions="Center" />
                            <controls:IconView Grid.Column="3" Kind="ChevronRight" IconSize="16" StrokeWidth="2"
                                Color="{StaticResource HzTextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ RIGHT: speed / IP / recommended ═══
                 A grid rather than a stack so the server list takes the leftover height.
                 Stacked, the three cards ended a third of the way down and left the rest of
                 the column bare next to a full-height card on the left. -->
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="16">

                <Border Grid.Row="0" Style="{StaticResource HzCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="СКОРОСТЬ" Style="{StaticResource HzEyebrow}" />
                        <controls:SpeedGraphView HeightRequest="54" IsActive="{Binding IsOn}" Level="{Binding SpeedLevel}" />
                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="↓ ЗАГРУЗКА" Style="{StaticResource HzEyebrow}" FontSize="11.5" CharacterSpacing="0.5" />
                                <Label Text="{Binding DownloadSpeed}" Style="{StaticResource HzBodyLabel}" FontSize="19" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="↑ ОТДАЧА" Style="{StaticResource HzEyebrow}" FontSize="11.5" CharacterSpacing="0.5" />
                                <Label Text="{Binding UploadSpeed}" Style="{StaticResource HzBodyLabel}" FontSize="19" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource HzCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="IP-АДРЕС" Style="{StaticResource HzEyebrow}" Margin="0,0,0,4" />
                        <Label Text="{Binding IpValue}" Style="{StaticResource HzBodyLabel}" FontSize="21" />
                        <Label Text="{Binding IpNote}" TextColor="{Binding IpColor}" FontSize="13.5"
                               FontAttributes="Bold" FontFamily="{StaticResource FontBold}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HzCard}" IsVisible="{Binding HasQuick}" VerticalOptions="Fill">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="РЕКОМЕНДУЕМЫЕ" Style="{StaticResource HzEyebrow}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuickServers}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10" MinimumHeightRequest="50">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference DesktopRoot}, Path=BindingContext.SelectQuickCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{StaticResource HzSurface3}" Stroke="{StaticResource HzBorderStrong}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                            <Label Text="{Binding Code}" TextColor="{StaticResource HzGoldLight}" FontSize="10.5"
                                                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                                   FontFamily="{StaticResource FontBold}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding City}" Style="{StaticResource HzBodyLabel}" FontSize="15"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding PingColor}" VerticalOptions="Center" />
                                            <Label Text="{Binding PingText}" Style="{StaticResource HzDim}" FontSize="13.5" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentView>
