<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Horus.Presentation.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
    xmlns:models="clr-namespace:Horus.Domain.Models"
    x:DataType="vm:SettingsViewModel"
    Title="Settings"
    BackgroundColor="{StaticResource DeepVoid}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ── Account ─────────────────────────────────────────────── -->
            <Label Text="Account" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="48,*,Auto">
                        <Frame
                            Grid.Column="0"
                            CornerRadius="24" WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{StaticResource NeonViolet}"
                            Padding="0" HasShadow="False">
                            <Label
                                Text="👤"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                FontSize="20" />
                        </Frame>

                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label Text="{Binding Username}" Style="{StaticResource LabelPrimary}" FontAttributes="Bold" />
                            <Label Text="{Binding RenewalDate, StringFormat='Renewal: {0}'}" Style="{StaticResource LabelSecondary}" />
                        </VerticalStackLayout>

                        <Frame
                            Grid.Column="2"
                            BackgroundColor="{StaticResource NeonViolet}"
                            CornerRadius="8" Padding="8,4" HasShadow="False">
                            <Label Text="{Binding PlanBadge}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Frame>
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Button
                        Text="Sign Out"
                        Style="{StaticResource ButtonGhost}"
                        TextColor="{StaticResource StatusDisconnected}"
                        BorderColor="{StaticResource StatusDisconnected}"
                        Command="{Binding SignOutCommand}"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Frame>

            <!-- ── Connection ──────────────────────────────────────────── -->
            <Label Text="Connection" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Auto-Connect on start" Style="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutoConnect}" ThumbColor="{StaticResource NeonCyan}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Kill Switch" Style="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding KillSwitch}" ThumbColor="{StaticResource NeonCyan}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Custom DNS" Style="{StaticResource LabelCaption}" />
                        <Entry Text="{Binding CustomDns}" Style="{StaticResource EntryField}" Placeholder="1.1.1.1, 8.8.8.8" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- ── Geo Routing ────────────────────────────────────────── -->
            <Label Text="Geo Routing" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Bypass Russian IPs (Direct)" Style="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RuBypassEnabled}" ThumbColor="{StaticResource NeonCyan}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="GeoIP Database" Style="{StaticResource LabelPrimary}" />
                            <Label Text="{Binding GeoDbStatus}" Style="{StaticResource LabelSecondary}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Update"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding UpdateGeoDbCommand}"
                            IsEnabled="{Binding IsUpdatingGeoDb, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>

                    <ActivityIndicator
                        IsVisible="{Binding IsUpdatingGeoDb}"
                        IsRunning="{Binding IsUpdatingGeoDb}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Start" />

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Routing Rules" Style="{StaticResource LabelPrimary}" />
                            <Label Text="{Binding RoutingRulesStatus}" Style="{StaticResource LabelSecondary}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Refresh"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding RefreshRoutingRulesCommand}"
                            IsEnabled="{Binding IsUpdatingRules, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>

                    <ActivityIndicator
                        IsVisible="{Binding IsUpdatingRules}"
                        IsRunning="{Binding IsUpdatingRules}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Start" />

                </VerticalStackLayout>
            </Frame>

            <!-- ── Split Tunneling ────────────────────────────────────── -->
            <Label
                Text="Split Tunneling"
                Style="{StaticResource LabelCaption}"
                IsVisible="{Binding SplitTunnelingSupported}" />
            <Frame
                Style="{StaticResource CardFrame}"
                IsVisible="{Binding SplitTunnelingSupported}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Select which apps/processes route through VPN." Style="{StaticResource LabelSecondary}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mode" Style="{StaticResource LabelCaption}" />
                        <Picker
                            Title="Select mode"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource NightPurple}"
                            x:Name="SplitModePicker"
                            SelectedIndexChanged="OnSplitModeChanged">
                            <Picker.Items>
                                <x:String>Disabled</x:String>
                                <x:String>Whitelist — only these apps use VPN</x:String>
                                <x:String>Blacklist — these apps bypass VPN</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <Button
                        Text="Load Apps / Processes"
                        Style="{StaticResource ButtonGhost}"
                        Clicked="OnLoadAppsClicked"
                        IsEnabled="{Binding IsLoadingApps, Converter={StaticResource InvertBoolConverter}}" />

                    <ActivityIndicator
                        IsVisible="{Binding IsLoadingApps}"
                        IsRunning="{Binding IsLoadingApps}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Start" />

                    <!-- App list -->
                    <CollectionView
                        x:Name="AppsCollection"
                        ItemsSource="{Binding AvailableApps}"
                        MaximumHeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppOrProcessEntry">
                                <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DisplayName}" Style="{StaticResource LabelPrimary}" />
                                        <Label Text="{Binding Id}" Style="{StaticResource LabelSecondary}" />
                                    </VerticalStackLayout>
                                    <CheckBox
                                        Grid.Column="1"
                                        Color="{StaticResource NeonCyan}"
                                        VerticalOptions="Center"
                                        CheckedChanged="OnAppCheckChanged"
                                        BindingContext="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>

            <!-- ── Protocol Binary ────────────────────────────────────── -->
            <Label Text="Protocol Binary" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Hysteria2" Style="{StaticResource LabelPrimary}" />
                            <Label Text="{Binding Hysteria2Version}" Style="{StaticResource LabelSecondary}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Check Update"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding UpdateHysteria2Command}"
                            IsEnabled="{Binding IsUpdatingBinary, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>
                    <ActivityIndicator
                        IsVisible="{Binding IsUpdatingBinary}"
                        IsRunning="{Binding IsUpdatingBinary}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

            <!-- ── Diagnostics ────────────────────────────────────────── -->
            <Label Text="Diagnostics" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Send anonymized error logs to support. No personal data (IPs, tokens) is included."
                        Style="{StaticResource LabelSecondary}" />
                    <Button
                        Text="Send Diagnostics"
                        Style="{StaticResource ButtonGhost}"
                        Command="{Binding SendDiagnosticsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                    <ActivityIndicator
                        IsVisible="{Binding IsBusy}"
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

            <!-- ── About ──────────────────────────────────────────────── -->
            <Label Text="About" Style="{StaticResource LabelCaption}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Version" Style="{StaticResource LabelPrimary}" />
                        <Label Grid.Column="1" Text="1.0.0" Style="{StaticResource LabelSecondary}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Button Text="Privacy Policy" Style="{StaticResource ButtonGhost}" HorizontalOptions="Fill" />
                    <Button Text="Open Source Licenses" Style="{StaticResource ButtonGhost}" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Frame>

            <!-- ── Status toast ───────────────────────────────────────── -->
            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource LabelAccent}"
                HorizontalOptions="Center" />

            <BoxView HeightRequest="32" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
