<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
             xmlns:screens="clr-namespace:Horus.Presentation.View.Screens"
             xmlns:controls="clr-namespace:Horus.Presentation.View.Controls"
             x:DataType="vm:ShellViewModel"
             x:Class="Horus.Presentation.View.RootPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource HzBg}">

    <!-- z-stack: [background glows] [app frame] under [payment overlay] -->
    <Grid>

        <!-- Decorative radial glows (per the design's purple bg gradients) -->
        <Grid InputTransparent="True" IsClippedToBounds="True">
            <Ellipse WidthRequest="1000" HeightRequest="760" HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-240,-220,0" InputTransparent="True">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                        <GradientStop Color="#4A5C2A78" Offset="0.0" />
                        <GradientStop Color="#005C2A78" Offset="0.62" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse WidthRequest="860" HeightRequest="680" HorizontalOptions="Start" VerticalOptions="Center"
                     Margin="-280,0,0,0" InputTransparent="True">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                        <GradientStop Color="#4D3D1850" Offset="0.0" />
                        <GradientStop Color="#003D1850" Offset="0.6" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid RowDefinitions="*,Auto">

            <!-- Main area: [sidebar (desktop)] [content] -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

                <!-- ═══ WINDOWS / DESKTOP SIDEBAR ═══ -->
                <Border Grid.Column="0" WidthRequest="268" IsVisible="{Binding IsSidebarVisible}"
                        BackgroundColor="Transparent" Stroke="Transparent" Padding="16,20,16,18">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">

                        <HorizontalStackLayout Grid.Row="0" Spacing="11" Padding="10,4,0,16">
                            <Image Source="logo_gold.png" HeightRequest="32" VerticalOptions="Center" />
                            <Label Text="HORUS" Style="{StaticResource HzDisplay}" FontSize="19" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="4">
                            <Border Padding="0" StrokeThickness="0"
                                    BackgroundColor="{Binding TabHomeActive, Converter={StaticResource ActiveTabBg}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavHomeCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13" Padding="15,0" HeightRequest="52">
                                    <controls:IconView Grid.Column="0" Kind="Home" IconSize="22" StrokeWidth="1.9" VerticalOptions="Center"
                                        Color="{Binding TabHomeActive, Converter={StaticResource ActiveTextColor}}" />
                                    <Label Grid.Column="1" Text="Главная" VerticalOptions="Center" FontSize="15.5"
                                        FontFamily="{StaticResource FontBold}" FontAttributes="Bold"
                                        TextColor="{Binding TabHomeActive, Converter={StaticResource ActiveTextColor}}" />
                                </Grid>
                            </Border>
                            <Border Padding="0" StrokeThickness="0"
                                    BackgroundColor="{Binding TabServersActive, Converter={StaticResource ActiveTabBg}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavServersCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13" Padding="15,0" HeightRequest="52">
                                    <controls:IconView Grid.Column="0" Kind="Servers" IconSize="22" StrokeWidth="1.7" VerticalOptions="Center"
                                        Color="{Binding TabServersActive, Converter={StaticResource ActiveTextColor}}" />
                                    <Label Grid.Column="1" Text="Серверы" VerticalOptions="Center" FontSize="15.5"
                                        FontFamily="{StaticResource FontBold}" FontAttributes="Bold"
                                        TextColor="{Binding TabServersActive, Converter={StaticResource ActiveTextColor}}" />
                                </Grid>
                            </Border>
                            <Border Padding="0" StrokeThickness="0"
                                    BackgroundColor="{Binding TabSettingsActive, Converter={StaticResource ActiveTabBg}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavSettingsCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13" Padding="15,0" HeightRequest="52">
                                    <controls:IconView Grid.Column="0" Kind="Settings" IconSize="22" StrokeWidth="1.9" VerticalOptions="Center"
                                        Color="{Binding TabSettingsActive, Converter={StaticResource ActiveTextColor}}" />
                                    <Label Grid.Column="1" Text="Настройки" VerticalOptions="Center" FontSize="15.5"
                                        FontFamily="{StaticResource FontBold}" FontAttributes="Bold"
                                        TextColor="{Binding TabSettingsActive, Converter={StaticResource ActiveTextColor}}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Account card.
                             Sizes were 12/11/12 with Bold on all three, which is where the
                             mangled Cyrillic showed worst: at that size the bold face has
                             barely three pixels of stem to work with. The account name also
                             drops Bold — a login is data, not emphasis, and regular weight
                             renders cleanly at any size. -->
                        <Border Grid.Row="3" Style="{StaticResource HzCard}" Padding="16,15">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="{Binding AccountEmail}" Style="{StaticResource HzSemiBold}" FontSize="15"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubLine}" TextColor="{Binding SubLineColor}" FontSize="13.5"
                                       FontFamily="{StaticResource FontBody}" />
                                <Button Text="{Binding RenewLabel}" HeightRequest="42" CornerRadius="11"
                                        BackgroundColor="{StaticResource HzGoldSoft}" BorderColor="{StaticResource HzGoldBorder}"
                                        BorderWidth="1" TextColor="{StaticResource HzGoldLight}" FontSize="14.5" FontAttributes="Bold"
                                        FontFamily="{StaticResource FontBody}" Command="{Binding OpenPayCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ CONTENT HOST (all screens; one visible at a time) ═══ -->
                <Grid Grid.Column="1">
                    <!-- Startup: shown until the stored session has been read.
                         Android always paints a window background before the first MAUI
                         frame — that native splash cannot be a MAUI page. So instead of
                         fighting it, this matches it exactly: same artwork, same 170x120
                         size (MauiSplashScreen BaseSize), same #0B0512 ground. The handover
                         is then invisible and the two read as one screen. -->
                    <Grid IsVisible="{Binding IsStartup}">
                        <Image Source="logo_gold.png" HeightRequest="120"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding HasStartupError, Converter={StaticResource InvertBoolConverter}}" />

                        <!-- Missing native components. Deliberately a dead end: there is
                             nothing useful the app can do without its core, and letting the
                             user in would only turn one clear problem into several vague ones. -->
                        <ScrollView IsVisible="{Binding HasStartupError}" Padding="28,40">
                            <VerticalStackLayout Spacing="14" VerticalOptions="Center"
                                                 MaximumWidthRequest="560" HorizontalOptions="Center">
                                <Image Source="logo_gold.png" HeightRequest="64" HorizontalOptions="Center" Opacity="0.5" />
                                <Label Text="Приложение не может запуститься"
                                       Style="{StaticResource HzDisplay}" FontSize="18"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="{StaticResource HzSurface}" Padding="16,14">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Label Text="{Binding StartupError}" Style="{StaticResource HzDim}"
                                           FontSize="13" LineHeight="1.35" />
                                </Border>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                    <Grid IsVisible="{Binding IsOnboarding}"><screens:OnboardingView BindingContext="{Binding Auth}" /></Grid>
                    <Grid IsVisible="{Binding IsLogin}"><screens:LoginView BindingContext="{Binding Auth}" /></Grid>
                    <Grid IsVisible="{Binding IsRegister}"><screens:RegisterView BindingContext="{Binding Auth}" /></Grid>
                    <Grid IsVisible="{Binding IsConfirm}"><screens:ConfirmView BindingContext="{Binding Auth}" /></Grid>
                    <Grid IsVisible="{Binding IsReset}"><screens:ResetView BindingContext="{Binding Auth}" /></Grid>
                    <Grid IsVisible="{Binding IsHome}">
                        <screens:HomeViewDesktop BindingContext="{Binding Main}" IsVisible="{OnIdiom Desktop=True, Tablet=True, Default=False}" />
                        <screens:HomeView BindingContext="{Binding Main}" IsVisible="{OnIdiom Phone=True, Default=False}" />
                    </Grid>
                    <Grid IsVisible="{Binding IsServers}"><screens:ServersView BindingContext="{Binding Servers}" /></Grid>
                    <Grid IsVisible="{Binding IsSettings}"><screens:SettingsView BindingContext="{Binding Settings}" /></Grid>
                    <Grid IsVisible="{Binding IsSplit}"><screens:SplitTunnelingView BindingContext="{Binding Settings}" /></Grid>
                </Grid>
            </Grid>

            <!-- ═══ ANDROID / PHONE BOTTOM TAB BAR ═══ -->
            <Border Grid.Row="1" IsVisible="{Binding IsBottomBarVisible}" BackgroundColor="#E60E0718"
                    Stroke="{StaticResource HzBorder}" StrokeThickness="1" Padding="0">
                <Border.StrokeShape><Rectangle /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*" HeightRequest="62">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavHomeCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <controls:IconView Kind="Home" IconSize="22" StrokeWidth="1.9" HorizontalOptions="Center"
                            Color="{Binding TabHomeActive, Converter={StaticResource ActiveTextColor}}" />
                        <Label Text="Главная" FontSize="10" FontAttributes="Bold" FontFamily="{StaticResource FontBold}"
                               TextColor="{Binding TabHomeActive, Converter={StaticResource ActiveTextColor}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavServersCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <controls:IconView Kind="Servers" IconSize="22" StrokeWidth="1.7" HorizontalOptions="Center"
                            Color="{Binding TabServersActive, Converter={StaticResource ActiveTextColor}}" />
                        <Label Text="Серверы" FontSize="10" FontAttributes="Bold" FontFamily="{StaticResource FontBold}"
                               TextColor="{Binding TabServersActive, Converter={StaticResource ActiveTextColor}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavSettingsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <controls:IconView Kind="Settings" IconSize="22" StrokeWidth="1.9" HorizontalOptions="Center"
                            Color="{Binding TabSettingsActive, Converter={StaticResource ActiveTextColor}}" />
                        <Label Text="Настройки" FontSize="10" FontAttributes="Bold" FontFamily="{StaticResource FontBold}"
                               TextColor="{Binding TabSettingsActive, Converter={StaticResource ActiveTextColor}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ PAYMENT OVERLAY ═══ -->
        <Grid IsVisible="{Binding Payment.IsVisible}">
            <screens:PaymentOverlayView BindingContext="{Binding Payment}" />
        </Grid>
    </Grid>
</ContentPage>
