<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Horus"
             x:Class="Horus.Presentation.View.MainPage"
             Shell.BackgroundColor="{StaticResource NightPurple}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*"
          BackgroundColor="{StaticResource DeepVoid}">

        <!-- ── SUBTLE BACKGROUND GLOW (single, soft) ── -->
        <Ellipse InputTransparent="True"
                 WidthRequest="460"
                 HeightRequest="460"
                 HorizontalOptions="Center"
                 VerticalOptions="Start"
                 Margin="0,-120,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="#33322445" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ════════════════════════════════════════════════════════ -->
        <!--                  SCROLLABLE BODY                         -->
        <!-- ════════════════════════════════════════════════════════ -->
        <ScrollView>
            <VerticalStackLayout x:Name="ContentStack"
                                 Spacing="28" Padding="24,24"
                                 Opacity="0" TranslationY="40">

                <!-- ─────────────────────────────────── -->
                <!--         STATUS INDICATOR ROW        -->
                <!-- ─────────────────────────────────── -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="8"
                                   Margin="0,12,0,0">
                    <Ellipse x:Name="StatusDot"
                         WidthRequest="9"
                         HeightRequest="9"
                         Fill="{StaticResource StatusDisconnected}"
                         VerticalOptions="Center">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse"
                                Binding="{Binding ConnectionStatus}"
                                Value="Connected">
                                <Setter Property="Fill" Value="{StaticResource StatusConnected}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Ellipse"
                                Binding="{Binding ConnectionStatus}"
                                Value="Disconnected">
                                <Setter Property="Fill" Value="{StaticResource StatusDisconnected}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Ellipse"
                                Binding="{Binding ConnectionStatus}"
                                Value="Connecting">
                                <Setter Property="Fill" Value="{StaticResource StatusConnecting}" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Label x:Name="LblStatusText"
                       Text="Disconnected"
                       TextColor="{StaticResource StatusDisconnected}"
                       FontSize="14"
                       CharacterSpacing="0.5"
                       VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding ConnectionStatus}"
                                Value="Connected">
                                <Setter Property="TextColor" Value="{StaticResource StatusConnected}" />
                                <Setter Property="Text" Value="Connected"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding ConnectionStatus}"
                                Value="Disconnected">
                                <Setter Property="TextColor" Value="{StaticResource StatusDisconnected}" />
                                <Setter Property="Text" Value="Disconnected"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding ConnectionStatus}"
                                Value="Connecting">
                                <Setter Property="TextColor" Value="{StaticResource StatusConnecting}" />
                                <Setter Property="Text" Value="Connecting..."/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   BIG CONNECT BUTTON + STATUS RING  -->
                <!-- ─────────────────────────────────── -->
                <Grid HorizontalOptions="Center"
                  Margin="0,4,0,4">

                    <!-- Outer pulsing glow (decorative, animated in code-behind) -->
                    <Ellipse x:Name="OuterGlowRing"
                         WidthRequest="240"
                         HeightRequest="240"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                <GradientStop Color="#223FBCCB" Offset="0.62" />
                                <GradientStop Color="Transparent" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Thin ring stroke (spins while connecting) -->
                    <Ellipse x:Name="StrokeRing"
                         WidthRequest="196"
                         HeightRequest="196"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Stroke="{StaticResource OverlayBorder}"
                         StrokeThickness="1.5" />

                    <!-- Connect button circle -->
                    <Frame WidthRequest="186"
                        HeightRequest="186"
                        CornerRadius="93"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HasShadow="False"
                        BorderColor="Transparent"
                        BackgroundColor="{StaticResource CryptPurple}">
                        <Grid>
                            <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="6">
                                <Label Text="🛡"
                                   FontSize="46"
                                   TextColor="{StaticResource NeonCyan}"
                                   HorizontalOptions="Center" />
                                <Label x:Name="LblConnectStatus"
                                   Text="CONNECT"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2.5"
                                   TextColor="{StaticResource NeonCyan}"
                                   HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Connected">
                                            <Setter Property="Text" Value="DISCONNECT"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Disconnected">
                                            <Setter Property="Text" Value="CONNECT"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Connecting">
                                            <Setter Property="Text" Value="CONNECTING"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConnectTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Frame>

                </Grid>

                <!-- ─────────────────────────────────── -->
                <!--         SELECTED SERVER CARD        -->
                <!-- ─────────────────────────────────── -->
                <Frame Style="{StaticResource CardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Flag + Server info -->
                        <Frame Grid.Column="0"
                           WidthRequest="46"
                           HeightRequest="46"
                           CornerRadius="12"
                           Padding="0"
                           BackgroundColor="{StaticResource RaisedPurple}"
                           BorderColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center">
                            <Label Text="🇫🇮"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                         Spacing="3"
                                         Margin="14,0,0,0"
                                         VerticalOptions="Center">
                            <Label Text="Finland #1"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="15"
                               FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Helsinki"
                                   Style="{StaticResource LabelSecondary}" />
                                <Label Text="·"
                                   Style="{StaticResource LabelSecondary}" />
                                <Label Text="62 ms"
                                   TextColor="{StaticResource NeonGreen}"
                                   FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="26"
                               VerticalOptions="Center" />

                    </Grid>
                </Frame>

                <!-- ─────────────────────────────────── -->
                <!--         SESSION STATS ROW           -->
                <!-- ─────────────────────────────────── -->
                <Frame Style="{StaticResource CardFrame}" Padding="16,14">
                    <Grid ColumnDefinitions="*,1,*,1,*">

                        <!-- Duration -->
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                            <Label Text="DURATION"
                               Style="{StaticResource LabelCaption}"
                               HorizontalOptions="Center" />
                            <Label x:Name="LblDuration"
                               Text="{Binding SessionDuration}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="1" Style="{StaticResource Divider}"
                             WidthRequest="1" HeightRequest="36"
                             VerticalOptions="Center" />

                        <!-- Total data -->
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                            <Label Text="TOTAL DATA"
                               Style="{StaticResource LabelCaption}"
                               HorizontalOptions="Center" />
                            <Label x:Name="LblTotalData"
                               Text="{Binding TotalData}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="3" Style="{StaticResource Divider}"
                             WidthRequest="1" HeightRequest="36"
                             VerticalOptions="Center" />

                        <!-- Your IP -->
                        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                            <Label Text="YOUR IP"
                               Style="{StaticResource LabelCaption}"
                               HorizontalOptions="Center" />
                            <Label x:Name="LblIP"
                               Text="—"
                               TextColor="{StaticResource NeonGreen}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

                <!-- Bottom spacer -->
                <BoxView HeightRequest="8" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
