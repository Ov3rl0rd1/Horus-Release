<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Horus.Presentation.View.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Horus.Presentation.ViewModels"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DeepVoid}">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- Background glow -->
            <AbsoluteLayout HeightRequest="320">
                <BoxView
                    AbsoluteLayout.LayoutBounds="0.5,0,300,300"
                    AbsoluteLayout.LayoutFlags="XProportional"
                    Color="{StaticResource NeonViolet}"
                    Opacity="0.06"
                    CornerRadius="150" />

                <VerticalStackLayout
                    AbsoluteLayout.LayoutBounds="0.5,0.5,1,1"
                    AbsoluteLayout.LayoutFlags="All"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="6">
                    <Label
                        Text="HORUS"
                        Style="{StaticResource LabelHeadline}"
                        FontSize="38"
                        CharacterSpacing="8"
                        HorizontalOptions="Center" />
                    <Label
                        Text="CREATE ACCOUNT"
                        Style="{StaticResource LabelCaption}"
                        CharacterSpacing="4"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource NeonViolet}" />
                </VerticalStackLayout>
            </AbsoluteLayout>

            <!-- Form card -->
            <Frame Style="{StaticResource CardFrame}" Margin="24,0,24,24">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Username" Style="{StaticResource LabelCaption}" Margin="0,0,0,-8" />
                    <Entry
                        Text="{Binding Username}"
                        Style="{StaticResource EntryField}"
                        Placeholder="your_username"
                        ReturnType="Next" />

                    <Label Text="Email" Style="{StaticResource LabelCaption}" Margin="0,0,0,-8" />
                    <Entry
                        Text="{Binding Email}"
                        Style="{StaticResource EntryField}"
                        Placeholder="you@example.com"
                        Keyboard="Email"
                        ReturnType="Next" />

                    <Label Text="Password" Style="{StaticResource LabelCaption}" Margin="0,0,0,-8" />
                    <Grid ColumnDefinitions="*,44">
                        <Entry
                            Grid.Column="0"
                            Text="{Binding Password}"
                            Style="{StaticResource EntryField}"
                            Placeholder="Min. 8 characters"
                            IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertBoolConverter}}"
                            ReturnType="Next" />
                        <Button
                            Grid.Column="1"
                            Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToEyeConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource NeonCyan}"
                            FontSize="18"
                            Command="{Binding TogglePasswordVisibilityCommand}" />
                    </Grid>

                    <Label Text="Confirm Password" Style="{StaticResource LabelCaption}" Margin="0,0,0,-8" />
                    <Grid ColumnDefinitions="*,44">
                        <Entry
                            Grid.Column="0"
                            Text="{Binding PasswordConfirm}"
                            Style="{StaticResource EntryField}"
                            Placeholder="Repeat password"
                            IsPassword="{Binding IsPasswordConfirmVisible, Converter={StaticResource InvertBoolConverter}}"
                            ReturnType="Done"
                            ReturnCommand="{Binding RegisterCommand}" />
                        <Button
                            Grid.Column="1"
                            Text="{Binding IsPasswordConfirmVisible, Converter={StaticResource BoolToEyeConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource NeonCyan}"
                            FontSize="18"
                            Command="{Binding TogglePasswordConfirmVisibilityCommand}" />
                    </Grid>

                    <!-- Error message -->
                    <Frame
                        IsVisible="{Binding HasError}"
                        BackgroundColor="#33FF0000"
                        BorderColor="#88FF0000"
                        CornerRadius="8"
                        Padding="12,8">
                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="#FFAAAA"
                            FontSize="13" />
                    </Frame>

                    <!-- Register button -->
                    <Button
                        Text="CREATE ACCOUNT"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}" />

                    <!-- Loading indicator -->
                    <ActivityIndicator
                        IsVisible="{Binding IsLoading}"
                        IsRunning="{Binding IsLoading}"
                        Color="{StaticResource NeonCyan}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Back to login -->
            <Frame
                Style="{StaticResource CardFrame}"
                Margin="24,0,24,32"
                Padding="16">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="Already have an account?" Style="{StaticResource LabelSecondary}" VerticalOptions="Center" />
                    <Button
                        Text="Sign In"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource NeonCyan}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding GoToLoginCommand}" />
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
