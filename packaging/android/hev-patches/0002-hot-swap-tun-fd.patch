+/**
+ * hev_socks5_tunnel_set_fd:
+ * @fd: a new TUN file descriptor
+ *
+ * Move a running tunnel onto @fd. Blocks until the packet loop has adopted it,
+ * after which the caller owns the descriptor that was replaced and may close it.
+ *
+ * Meant for a host that can hand over an interface without dropping it -- an
+ * Android VpnService calling establish() a second time -- so that a rebuild does
+ * not have to stop and restart the tunnel.
+ *
+ * Returns: 0 on success, -1 if the tunnel is not running or the swap failed.
+ *
+ * Since: 2.17.0-horus
+ */
+int hev_socks5_tunnel_set_fd (int fd);
