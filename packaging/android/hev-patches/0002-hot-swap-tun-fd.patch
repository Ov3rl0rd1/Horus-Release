+/*
+ * Point a running tunnel at a different TUN descriptor.
+ *
+ * Exists for one caller: an Android VpnService rebuilding its interface. Calling
+ * VpnService.Builder.establish() again yields a new descriptor and invalidates
+ * the old one without the interface ever disappearing, which is the documented
+ * seamless hand-off -- but only if whatever is pumping packets can be moved onto
+ * the new descriptor. Without this the host has to stop the tunnel and start it
+ * again, and on Android that means building a foreground service from the
+ * background, which is restricted on 12+ and can be refused outright in Doze.
+ *
+ * Returns 0 once the io task has adopted the descriptor, at which point the
+ * caller owns the old one and may close it. -1 if the tunnel is not running, the
+ * descriptor is unusable, or the swap did not complete in time.
+ *
+ * The wait is a bounded spin because this is called from a thread outside the
+ * task system, where yielding is not available. It costs a few milliseconds once
+ * per rebuild.
+ */
+int
+hev_socks5_tunnel_set_fd (int fd)
+{
+    const int timeout_ms = 500;
+    int nonblock = 1;
+    int waited;
+
+    if (fd < 0)
+        return -1;
+    if (!READ_ONCE (run) || !task_lwip_io)
+        return -1;
+    /* Only one swap may be in flight; a second would lose the first. */
+    if (READ_ONCE (pending_tun_fd) >= 0)
+        return -1;
+
+    if (ioctl (fd, FIONBIO, (char *)&nonblock) < 0)
+        return -1;
+
+    WRITE_ONCE (pending_tun_fd, fd);
+    hev_task_wakeup (task_lwip_io);
+
+    for (waited = 0; waited < timeout_ms; waited++) {
+        if (READ_ONCE (pending_tun_fd) < 0)
+            return 0;
+        usleep (1000);
+    }
+
+    /* Give up and take the request back, so a later attempt is not blocked by a
+     * descriptor nobody adopted. */
+    WRITE_ONCE (pending_tun_fd, -1);
+    LOG_E ("socks5 tunnel fd swap timed out");
+    return -1;
+}
