 #define LOG_D(fmt...) hev_logger_log (HEV_LOGGER_DEBUG, fmt)
 #define LOG_I(fmt...) hev_logger_log (HEV_LOGGER_INFO, fmt)
 #define LOG_W(fmt...) hev_logger_log (HEV_LOGGER_WARN, fmt)
@@ -31,6 +35,15 @@ typedef enum
 } HevLoggerLevel;
 
