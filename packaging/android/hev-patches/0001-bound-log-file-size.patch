diff --git a/src/misc/hev-logger.c b/src/misc/hev-logger.c
index 3d536df..b62a807 100644
--- a/src/misc/hev-logger.c
+++ b/src/misc/hev-logger.c
@@ -20,6 +20,52 @@
 
 static int fd = -1;
 static HevLoggerLevel req_level;
+static size_t max_size;
+static size_t written;
+
+void
+hev_logger_set_max_size (size_t size)
+{
+    max_size = size;
+}
+
+/*
+ * Keep the log from growing without bound.
+ *
+ * A tunnel embedded in a mobile client can stay up for weeks, and at the
+ * verbose level that a user is asked to turn on when something is wrong, this
+ * file grows the whole time. There is nothing here that would ever stop it.
+ *
+ * The file is truncated in place rather than rotated to a .1 generation, which
+ * is the usual answer, because it has two independent writers: hev-logger and
+ * hev-socks5-core's own logger are both handed the same path and each holds its
+ * own descriptor. Renaming from one of them would leave the other appending to
+ * the renamed inode forever. Truncation has no such problem -- both fds are
+ * O_APPEND, so the kernel re-seeks each write to the (now zero) end of file and
+ * both writers simply carry on.
+ *
+ * The cost is that the discarded history is gone rather than kept for one more
+ * generation. That is acceptable here because the host already keeps the
+ * previous session's log alongside the current one; this bound only has to stop
+ * a single session running away.
+ *
+ * The counter is a plain static. With multi-queue enabled two threads could
+ * race it, and the worst outcome is a second truncation immediately after the
+ * first -- harmless, and not worth a lock on the logging path.
+ */
+static void
+hev_logger_bound (size_t added)
+{
+    written += added;
+
+    if (!max_size || written < max_size)
+        return;
+
+    if (ftruncate (fd, 0) == 0) {
+        /* ignore return value */
+    }
+    written = 0;
+}
 
 int
 hev_logger_init (HevLoggerLevel level, const char *path)
@@ -39,6 +85,12 @@ hev_logger_init (HevLoggerLevel level, const char *path)
     if (fd < 0)
         return -1;
 
+    /* Start from what is already there, so an existing file counts towards the
+     * cap instead of being allowed a fresh allowance on every restart. */
+    written = lseek (fd, 0, SEEK_END);
+    if (written == (size_t)-1)
+        written = 0;
+
     return 0;
 }
 
@@ -112,7 +164,7 @@ hev_logger_log (HevLoggerLevel level, const char *fmt, ...)
     iov[3].iov_base = "\n";
     iov[3].iov_len = 1;
 
-    if (writev (fd, iov, 4)) {
-        /* ignore return value */
-    }
+    len = writev (fd, iov, 4);
+    if (len > 0)
+        hev_logger_bound (len);
 }
diff --git a/src/misc/hev-logger.h b/src/misc/hev-logger.h
index 9a1c070..c51d1cd 100644
